{
	admin off
	auto_https off
	servers {
		trusted_proxies static 100.64.0.0/10 fd00::/8 152.233.0.0/17
	}
}

:{$PORT:8080} {
	encode zstd gzip

	# Health check for this service only. It must never probe APISIX: until the
	# gateway's container exists its private name does not resolve at all, which
	# would fail this service's own deployment.
	handle /healthz {
		respond "ok" 200
	}

	# The Admin API server has no handler at /, so send visitors to the dashboard.
	handle / {
		# The `*` matcher is required: redir reads a leading-slash first argument
		# as a matcher, so `redir /ui/ 302` would silently answer an empty 200.
		redir * /ui/ 302
	}

	handle {
		reverse_proxy {$APISIX_ADMIN_UPSTREAM:http://apisix.railway.internal:9180} {
			header_up X-Real-IP {client_ip}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
