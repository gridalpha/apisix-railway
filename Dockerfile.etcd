# etcd for Apache APISIX.
#
# The upstream image is distroless, so it has no shell for the boot-time RBAC
# bootstrap and its declared WORKDIR does not exist in the image, which Railway
# refuses outright. Both etcd binaries are static, so lifting them onto Alpine
# costs one layer and gives the entrypoint a shell.
#
# Pinned: etcd owns an on-disk format, and quay.io publishes no floating minor
# tag. Bump deliberately, minor by minor.
FROM quay.io/coreos/etcd:v3.6.14 AS upstream

FROM alpine:3.22

RUN apk add --no-cache ca-certificates

COPY --from=upstream /usr/local/bin/etcd /usr/local/bin/etcdctl /usr/local/bin/
COPY etcd/entrypoint.sh /usr/local/bin/railway-entrypoint.sh

RUN chmod 0755 /usr/local/bin/railway-entrypoint.sh \
    && sh -n /usr/local/bin/railway-entrypoint.sh \
    && etcd --version \
    && etcdctl version

EXPOSE 2379 2380

CMD ["/usr/local/bin/railway-entrypoint.sh"]
